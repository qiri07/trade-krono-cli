# LLM API Key（至少配置一个）
DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# Kronos 配置
KRONOS_MODEL=kronos-base
KRONOS_DEVICE=cpu
KRONOS_LOOKBACK=400
KRONOS_PRED_LEN=30

# Backend API URL
BACKEND_URL=https://apihub.agnes-ai.cn/v1

# TradingAgents 配置
LLM_PROVIDER=deepseek
MAX_DEBATE_ROUNDS=1

# 路径配置（如果项目位置不同请修改）
# TRADINGAGENTS_ROOT=/path/to/TradingAgents-astock
# KRONOS_ROOT=/path/to/Kronos
