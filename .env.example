# LLM API Key（至少配置一个）
DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# MINIMAX_API_KEY=xxx
# AGNES_API_KEY=xxx

# Backend API URL（部分供应商需要）
BACKEND_URL=https://apihub.agnes-ai.cn/v1

# ── LLM 行为配置 ────────────────────────────────────────
LLM_PROVIDER=deepseek          # 默认 LLM 供应商
DEEP_THINK_LLM=deepseek-chat   # 深度思考模型
QUICK_THINK_LLM=deepseek-chat  # 快速思考模型
MAX_DEBATE_ROUNDS=1            # 辩论最大轮次（0 = 不辩论）
MAX_RISK_DISCUSS_ROUNDS=1      # 风险分析最大轮次
CHECKPOINT_ENABLED=true        # 启用检查点（跳过已完成分析）
OUTPUT_LANGUAGE=Chinese        # 报告语言：Chinese / English

# ── Kronos 配置 ─────────────────────────────────────────
KRONOS_MODEL=kronos-base       # 模型名称
KRONOS_TOKENIZER=kronos-Tokenizer-base  # Tokenizer 名称
KRONOS_DEVICE=cpu              # cpu / cuda:0（需要 GPU）
KRONOS_LOOKBACK=400            # 历史 K 线回看长度
KRONOS_PRED_LEN=30             # 预测步长
KRONOS_SAMPLE_COUNT=1          # 采样次数（>1 启用真实不确定性量化）
KRONOS_T=1.0                   # 采样温度
KRONOS_TOP_P=0.9               # nucleus sampling 阈值
KRONOS_USE_SAMPLE_CONFIDENCE=false  # 是否启用基于多 sample 的不确定性量化

# ── 过滤配置 ────────────────────────────────────────────
MIN_CONFIDENCE=55.0            # 最低 TA 置信度阈值
ALLOWED_SIGNALS=BUY,HOLD       # 允许的 TA 信号（逗号分隔）；可选追加 OVERWEIGHT、SELL

# ── 前置股票池过滤（UniverseEngine）────────────────────
FILTER_EXCLUDE_ST=true         # 排除 ST/*ST 股票
FILTER_EXCLUDE_LOW_PRICE=true  # 排除低价股
FILTER_LOW_PRICE_THRESHOLD=3.0 # 低价股阈值（元），低于此价排除
FILTER_MIN_PB=                 # 最低市净率（空=不限制），PB 低于此值视为高风险
FILTER_MARKET_CAP_RANGE=       # 市值范围（亿元），格式："50,5000"
FILTER_MARKET_CAP_MIN=         # 市值最小值（亿元），低于此值排除
FILTER_PE_RANGE=               # PE 区间，格式："5,30"
FILTER_PB_RANGE=               # PB 区间，格式："0,3"
FILTER_INDUSTRY_WHITELIST=     # 行业白名单，逗号分隔
FILTER_INDUSTRY_BLACKLIST=     # 行业黑名单，逗号分隔
FILTER_MAX_RISK_SCORE=         # 风险分上限（0-1）
FILTER_MIN_VOLUME_RATIO=       # 最小量比
FILTER_MIN_TURNOVER_RATE=      # 最小换手率（%）
FILTER_MIN_VOLUME=             # 最小成交量（股），低于此值排除（如 10000000 表示 1000 万股）
# ── 同花顺数据源 ───────────────────────────────────────
# TONGHUASHUN_ENABLED=true         # 是否启用同花顺数据源
# HITHINK_FINANCE_API_KEY=         # 同花顺 API Key，在 https://fuyao.aicubes.cn/admin 获取
# FUYAO_API_KEY=                   # 同花顺 API Key（旧名称，兼容）
# 同步全量 A 股 K 线缓存：
#   uv run trade-krono-cli sync-universe                # 首次全量（~5000只，需数小时）
#   uv run trade-krono-cli sync-universe --lookback 730  # 增量更新（仅拉新数据）

# ── 同步白名单 ──────────────────────────────────────────
# SYNC_WHITELIST=600519,000858,300750  # 优先拉取的股票（逗号分隔，6位代码）
# 白名单股票在 sync-universe 时优先处理；
# 也可单独用 sync-whitelist 命令仅同步白名单。

# ── 数据获取配置 ────────────────────────────────────────
BAOSTOCK_SLEEP_SEC=1.0         # baostock 请求间隔（秒）
DATA_PROVIDER=baostock         # 主数据源：baostock / akshare / mootdx / tushare
DATA_FALLBACK=akshare,mootdx,tushare  # 主源失败时的备用数据源（逗号分隔）
AKSHARE_ENABLED=true           # 是否启用 akshare 数据源
MOOTDX_ENABLED=true            # 是否启用 mootdx 数据源
TONGHUASHUN_ENABLED=false      # 是否启用同花顺数据源（需 HITHINK_FINANCE_API_KEY）

# ── 重试策略配置 ────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3           # 最大重试次数
RETRY_BASE_DELAY=2.0           # 基础退避延迟（秒）
RETRY_JITTER=true              # 是否启用随机抖动
RETRY_RATE_LIMIT_BACKOFF=true  # 是否启用限流退避
RETRY_RATE_LIMIT_MAX_WAIT=60.0 # 限退避最大等待时间（秒）

# ── 降级策略配置 ────────────────────────────────────────
DEGRADE_MODE=strict            # strict / relaxed / fallback
TA_CACHE_FALLBACK_ENABLED=false # 是否启用 TA 缓存降级
TA_CACHE_MAX_AGE_DAYS=7        # TA 缓存最大有效天数

# ── 评分与风险配置 ──────────────────────────────────────
SCORING_STRATEGY=linear        # 评分策略：linear / weighted / custom
RISK_BOOST_STRATEGY=fixed_boost # 风险加分策略
RISK_BOOST_MULTIPLIER=1.0      # 风险加分倍数
RISK_BOOST_DIMINISHING_POWER=0.5 # 边际递减幂
FILTER_ABNORMALITY_RISK_BOOST=true  # 是否启用异常股风险加分

# ── 测试路径配置（CI/测试隔离用，生产环境无需设置）────
# TRADING_KRONO_CACHE_DIR=/tmp/test-cache
# TRADING_KRONO_RESULTS_DIR=/tmp/test-results

# ── 路径配置（可选，优先使用 external/repos.yaml）────────
# TRADINGAGENTS_ROOT=/path/to/TradingAgents-astock
# KRONOS_ROOT=/path/to/Kronos

